# ============================================================================
# Fund Analyser — Backend 环境变量（模板）
# ============================================================================
# 使用方式:
#   cp .env.example .env
#   编辑 .env 修改配置，然后 docker compose up -d
# ============================================================================

# ── LLM API Key（必填）──
DEEPSEEK_API_KEY=sk-your-key-here

# ── MySQL 密码（与 sql-docker/.env 保持一致）──
MYSQL_ROOT_PASSWORD=change-me

# ── JWT 签名密钥（生产环境请更换）──
JWT_SECRET_KEY=dev-secret-change-me

# ── CORS 允许的前端地址 ──
CORS_ORIGINS=http://localhost:5173

# ── 其他（通常不需要改）──
LLM_MAX_CONCURRENCY=10
MCP_ENABLED=true
TASK_LEASE_SECONDS=45
TASK_HEARTBEAT_INTERVAL_SECONDS=10
TASK_RECOVERY_SCAN_INTERVAL_SECONDS=15
TASK_RECOVERY_BATCH_SIZE=20
