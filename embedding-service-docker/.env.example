# Milvus 连接地址（Docker 内使用服务名 + 容器内部端口 19530）
MILVUS_URL=http://milvus-standalone:19530
MILVUS_HEALTH_URL=http://milvus-standalone:9091/healthz

# 模型挂载目录（宿主机路径）
EMBEDDING_MODEL_DIR=../embedding_model

# GPU 并发控制
GPU_CONCURRENCY=1

# 动态批处理重排器参数（单位：毫秒/条）
BATCH_RERANK_WAIT_MS=50

# 动态批处理重排器参数（最大批处理大小）
BATCH_RERANK_MAX=128

# 表格父子关联 MySQL。embedding-service 容器通过宿主机映射访问 sql-docker 暴露的 3306 端口。
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fund_analyser
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=5

# Milvus 等待超时参数（单位：秒）
MILVUS_WAIT_TIMEOUT_SECONDS=300
MILVUS_WAIT_INTERVAL_SECONDS=5
