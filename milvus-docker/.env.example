# ============================================================================
# Fund Analyser — Milvus + Embedding Service 环境变量（模板）
# ============================================================================
# 使用方式:
#   cp .env.example .env
#   编辑 .env 修改配置，然后 docker compose up -d
# ============================================================================

# Milvus 连接地址（Docker 内使用服务名 + 容器内部端口 19530）
MILVUS_URL=http://milvus-standalone:19530

# GPU 并发控制
GPU_CONCURRENCY=8

# 模型挂载目录（宿主机路径，可为相对路径或绝对路径）
# 例: ../embedding_model 或 /data/models/embedding_model
EMBEDDING_MODEL_DIR=../embedding_model

# Docker 数据卷目录（etcd/minio/milvus 持久化数据）
DOCKER_VOLUME_DIRECTORY=.
